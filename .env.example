# Copie para .env e preencha. Nunca versione o .env.
# Linhas comentadas têm valor padrão: descomente só para mudar.
# Para rodar com docker compose nada aqui é obrigatório: e-mail vai para o Mailpit e arquivos para o disco.

# Banco local (docker compose)
POSTGRES_DB=quickcare
POSTGRES_USER=quickcare
POSTGRES_PASSWORD=

# Segurança
# JWT_SECRET=

# Storage: local (disco, padrão do docker compose) ou supabase
STORAGE_TIPO=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=

# E-mail: no docker compose vai para o Mailpit. Fora dele, SMTP (EMAIL_APP) ou Brevo (BREVO_API_KEY)
EMAIL_APP=
EMAIL_APP_PASSWORD=
EMAIL_REMETENTE=
BREVO_API_KEY=
FRONTEND_URL=http://localhost:4200

# Pré-validação do admin. Sem token, a consulta de CPF fica desativada e o admin valida manualmente
SERPRO_CPF_TOKEN=
# SERPRO_CPF_URL=
# BRASILAPI_URL=
# VALIDACAO_EXTERNA_TIMEOUT_SEGUNDOS=

# Geocodificação (Nominatim)
# GEOCODIFICACAO_HABILITADA=
# GEOCODIFICACAO_URL=
# GEOCODIFICACAO_USER_AGENT=

# Admin criado ao subir (opcional)
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
ADMIN_CPF=

# Produção (perfil prod)
# SPRING_PROFILES_ACTIVE=
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# PORT=
# RENDER_EXTERNAL_URL=
# KEEP_ALIVE_HABILITADO=
